# Componode Environment Configuration
# Copy to .env and fill in values for your deployment.

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgres://componode:componode_pw@localhost:5432/componode
# SSL mode: "require" (production), "disable" (dev/local)
DATABASE_SSL_MODE=disable
# Path to CA cert for verify-full (optional, for remote Postgres)
# DATABASE_SSL_CA=/path/to/ca-cert.pem
MAX_DB_CONNECTIONS=10

# ── Bootstrap Admin (first boot only, ignored if DB is non-empty) ─
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Security ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
COOKIE_SECRET=
# Generate with: openssl rand -base64 32
CSRF_SECRET=

# ── CORS (optional, default disabled) ─────────────────────────────
# Comma-separated list of exact origins, e.g. https://componode.example.com
CORS_ALLOWED_ORIGINS=

# ── Debug (optional) ──────────────────────────────────────────────
# Set to "true" to include debug details in error responses (DO NOT enable in production)
DEBUG_ERROR_DETAILS=false
