{
  "name": "componode",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source Digital Product Asset Management",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @componode/backend db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.18.1",
    "prettier": "^3.4.2",
    "globals": "^15.14.0"
  },
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "main": "eslint.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estevanalex/componode.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/estevanalex/componode/issues"
  },
  "homepage": "https://github.com/estevanalex/componode#readme"
